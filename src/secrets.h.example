#pragma once

// Copy this file to secrets.h (git-ignored) and fill in your values.
// (The OTA password is in secrets.ini, see secrets.ini.example.)
#define WIFI_SSID   "your-wifi-ssid"
#define WIFI_PASS   "your-wifi-password"

// Telegraf's http_listener_v2 on the LAN (see telegraf/sump.conf). Readings and
// pump events are POSTed here as InfluxDB line protocol. Leave it out to
// disable (data is then only logged over serial).
#define TELEGRAF_URL "http://192.168.3.252:8186/sump"

// Optional: ntfy.sh topic for pump, alarm, daily-report and reboot pushes.
// Pick something random and unguessable (ntfy topics are unauthenticated --
// anyone who knows the exact name can read the messages), then subscribe to it
// in the ntfy app (iOS/Android) or web app. Leave it out to disable pushes.
#define NTFY_TOPIC    "your-random-ntfy-topic"
